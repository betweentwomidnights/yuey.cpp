<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Run with UTF-8 as the process code page (Windows 10 1903 and newer). yue2-train-run already reads
     its arguments as UTF-8 and starts the tools with wide command lines, but the tools themselves take a
     narrow argv, and std::filesystem::path(std::string), path::string() and fopen use the legacy system
     code page. A dataset path outside that code page reached them as "?", and accented names came back
     as invalid UTF-8. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
